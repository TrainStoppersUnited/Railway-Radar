# AWS S3 Darwin Credentials
# IMPORTANT: Never commit real credentials to version control!
# Copy this file to .env and fill in your actual values

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1
S3_BUCKET=darwin.xmltimetable
S3_PREFIX=PPTimetable/

PORT=3000

# Darwin Push Port - Kafka (Confluent Cloud)
# Get API Key & Secret from Rail Data Marketplace
KAFKA_BOOTSTRAP_SERVER=pkc-z3p1v0.europe-west2.gcp.confluent.cloud:9092
KAFKA_API_KEY=your_confluent_api_key_here
KAFKA_API_SECRET=your_confluent_api_secret_here
KAFKA_TOPIC=darwin.pushport-v16
KAFKA_GROUP_ID=railway-radar-consumer
